@using databasteknik.Controllers
@model IEnumerable<databasteknik.models.User>

@{
	ViewData["Title"] = "Users";
}

<h1>Users</h1>

<p>List of users:</p>
<table class="table">
	<thead>
		<tr>
			<th>UserId</th>
			<th>UserName</th>
			<th>Password</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var user in Model)
		{
			<tr>
				<td>@user.UserId</td>
				<td>@user.UserName</td>
				<td>@user.Password</td>
			</tr>
			
		}
	</tbody>